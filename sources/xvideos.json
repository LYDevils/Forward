{
  "version": 1,
  "name": "xvideos",
  "baseUrl": "https://www.xvideos.com",
  "match": {
    "domains": [
      "xvideos.com"
    ]
  },
  "request": {
    "timeout": 30000,
    "delayMs": [
      1000,
      2000
    ]
  },
  "search": {
    "path": "/?k={keyword}&p={page}",
    "itemSelector": ".thumb-block",
    "fields": {
      "title": {
        "selector": ".thumb-title"
      },
      "url": {
        "selector": "a",
        "attr": "href",
        "absolute": true
      },
      "thumbnail": {
        "selector": "img",
        "attr": "src"
      },
      "duration": {
        "selector": ".duration"
      }
    }
  },
  "extractVideo": {
    "fields": {
      "url": {
        "script": {
          "contains": "html5player.setVideoUrl",
          "regex": "html5player\\.setVideoUrl\\(['\\\"]([^'\\\"]+)['\\\"]\\)"
        }
      },
      "title": {
        "selector": "h1"
      },
      "thumbnail": {
        "selector": "meta[property=\"og:image\"]",
        "attr": "content"
      },
      "duration": {
        "selector": "meta[itemprop=\"duration\"]",
        "attr": "content"
      }
    }
  },
  "getVideoInfo": {
    "fields": {
      "title": {
        "selector": "h1"
      },
      "views": {
        "selector": ".nb-views"
      },
      "date": {
        "selector": ".upload_date"
      },
      "tags": {
        "selector": ".tags a",
        "list": true
      }
    }
  }
}
